# Copie este arquivo para `.env` e ajuste se necessário:
#   cp .env.example .env   (Linux/Mac)
#   Copy-Item .env.example .env   (PowerShell)

# Banco de dados PostgreSQL.
# Os valores abaixo batem com o docker-compose.yml padrão (usuário/senha/db = "rinha").
DATABASE_URL="postgresql://rinha:rinha@localhost:5432/rinha"

# Variáveis usadas pelo docker-compose (opcionais — têm defaults iguais aos de cima).
POSTGRES_USER="rinha"
POSTGRES_PASSWORD="rinha"
POSTGRES_DB="rinha"

# NextAuth — gere um segredo com: openssl rand -base64 32
NEXTAUTH_SECRET="troque-por-uma-string-aleatoria-longa"
NEXTAUTH_URL="http://localhost:3000"

# ─── Integração com o Discord (login + vínculo de conta via OAuth) ───────────
# Crie uma aplicação em https://discord.com/developers/applications
# e adicione DOIS Redirects em OAuth2:
#   ${NEXTAUTH_URL}/api/auth/callback/discord   (login "Entrar com Discord")
#   ${NEXTAUTH_URL}/api/discord/callback         (vínculo a partir de Minha Conta)
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# Public Key do app (aba "General Information") — valida a assinatura Ed25519 dos
# botões Aceitar/Recusar (Interactions Endpoint URL: ${NEXTAUTH_URL}/api/discord/interactions).
# Sem ela, POST /api/discord/interactions responde 401 (o resto do site funciona normal).
DISCORD_PUBLIC_KEY=""

# Cifra os tokens OAuth guardados no banco. Gere com: openssl rand -hex 32
# (se ausente, cai no NEXTAUTH_SECRET como fallback)
DISCORD_TOKEN_ENC_KEY=""

# Bot — necessário para auto-join no servidor E para os canais privados por equipe
# (criar canal ao cadastrar equipe, "Solicitar entrada", excluir canal). Sem eles,
# o site funciona normalmente, só não cria/gerencia canais no Discord.
# O bot precisa estar no servidor com permissão de "Gerenciar Canais".
DISCORD_BOT_TOKEN=""
DISCORD_GUILD_ID=""

# Opcional — id de uma categoria para agrupar os canais das equipes.
DISCORD_TEAMS_CATEGORY_ID=""

# ─── Observabilidade (OpenTelemetry) ─────────────────────────────────────────
# A instrumentação (src/instrumentation.ts) lê estas variáveis automaticamente e
# passa a exportar traces/métricas/logs. Sem elas, o app roda normal, só não
# envia telemetria.
#
# OTEL_SERVICE_NAME  → nome que identifica a equipe no Grafana (Tempo).
# OTEL_EXPORTER_OTLP_ENDPOINT → para onde a telemetria vai. Duas opções:
#   • Backend REMOTO da disciplina (precisa do header Authorization abaixo):
#       OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.dsc.rodrigor.com
#       OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer <token-da-sua-equipe>
#   • otel-lgtm LOCAL (suba com: docker compose up -d otel-lgtm) — sem header:
#       OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318   (ou http://otel-lgtm:4318 dentro do Docker)
OTEL_SERVICE_NAME="dsc-eqNN"
OTEL_EXPORTER_OTLP_ENDPOINT="https://otel.dsc.rodrigor.com"
OTEL_EXPORTER_OTLP_PROTOCOL="http/protobuf"
OTEL_EXPORTER_OTLP_HEADERS="Authorization=Bearer TROQUE-PELO-TOKEN-DA-SUA-EQUIPE"
OTEL_TRACES_EXPORTER="otlp"
OTEL_METRICS_EXPORTER="otlp"
OTEL_LOGS_EXPORTER="otlp"
