{
  "name": "feche-seu-time",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "mcp": "tsx mcp/server.ts",
    "mcp:inspector": "npx @modelcontextprotocol/inspector node mcp/server.ts",
    "loadtest": "k6 run -e LEVEL=media loadtest/carga.js",
    "loadtest:smoke": "k6 run -e LEVEL=smoke loadtest/carga.js",
    "loadtest:leve": "k6 run -e LEVEL=leve loadtest/carga.js",
    "loadtest:pesada": "k6 run -e LEVEL=pesada loadtest/carga.js",
    "loadtest:stress": "k6 run -e LEVEL=stress loadtest/carga.js",
    "loadtest:report": "k6 run -e LEVEL=media --summary-export=loadtest/resultado.json loadtest/carga.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "next": "16.2.7",
    "next-auth": "^4.24.14",
    "prisma": "^7.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
