generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum Lane {
  TOP
  JUNGLE
  MID
  ADC
  SUPPORT
  FILL
}

enum StatusEquipe {
  ABERTA
  COMPLETA
}

enum StatusCandidatura {
  PENDENTE
  ACEITA
  RECUSADA
}

model User {
  id          String   @id @default(cuid())
  username    String   @unique
  password    String?  // vira opcional (quem loga só pelo Discord não tem senha)
  role        Role     @default(USER)
  discordId   String?  @unique
  discordTag  String?  // ex: "username#0000" ou só "username" (Discord novo)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Vínculo real do Discord (OAuth). A verdade do contato passa a ser o discordId,
  // não mais o texto livre que ficava em FreeAgent/Equipe.
  discordUsername     String? // para exibição (global_name ou username)
  discordAccessToken  String? // OAuth (guilds.join) — guardado cifrado
  discordRefreshToken String? // OAuth — guardado cifrado
  discordTokenExpires DateTime?
  freeAgents   FreeAgent[]
  equipes      Equipe[]
  candidaturas Candidatura[]
  auditLogs    AuditLog[]    @relation("AuditActor")
}

model FreeAgent {
  id             String   @id @default(cuid())
  nickname       String
  lanePrincipal  Lane
  laneSecundaria Lane?
  createdAt      DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Equipe {
  id               String       @id @default(cuid())
  nome             String
  nicknameCapitao  String
  vagasLanes       Lane[]
  discordChannelId String? // canal privado da equipe no Discord
  status           StatusEquipe @default(ABERTA)
  createdAt        DateTime     @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  candidaturas Candidatura[]
}

model Candidatura {
  id        String            @id @default(cuid())
  lane      Lane // vaga (lane) pretendida
  status    StatusCandidatura @default(PENDENTE)
  createdAt DateTime          @default(now())

  equipeId String
  equipe   Equipe @relation(fields: [equipeId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Idempotência: um mesmo usuário não duplica o pedido para a mesma vaga.
  @@unique([equipeId, userId, lane])
}

/// Log de auditoria: trilha imutável de QUEM fez O QUÊ e QUANDO.
/// Escrito best-effort por `src/lib/audit.ts` nos pontos de mutação.
model AuditLog {
  id         String   @id @default(cuid())
  action     String // ação namespaced, ex.: "equipe.create" (ver AuditAction em src/lib/audit.ts)
  actorId    String? // quem executou; null = sistema ou anônimo
  actorLabel String? // username no momento do evento (preservado mesmo se a conta for removida)
  targetType String? // recurso afetado: "Equipe" | "FreeAgent" | "Candidatura" | "User"
  targetId   String? // id do recurso afetado
  metadata   Json? // payload contextual (lane, status, mudanças, etc.)
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  // SetNull preserva a trilha de auditoria mesmo que o usuário seja deletado.
  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
}
